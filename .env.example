# Public base URL of the site, without a trailing slash (http://localhost:3000 in development).
NEXT_PUBLIC_SITE_URL=
# Supabase API URL (http://127.0.0.1:54321 for the local stack; printed by `supabase status`).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/publishable key: safe for the browser, access is governed by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role/secret key: bypasses RLS, server-only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
