# ZUVIO environment. Copy to .env.local (git-ignored) and fill in.
# Only the first three variables are required; every other integration is optional and the
# feature degrades visibly when it is unset (see GET /api/v1/health -> integrations).
# This file lists exactly the variables the code reads (src/server/env.ts).

# ───────────── Required (public: inlined into the browser bundle) ─────────────
# Public base URL of the site, without a trailing slash (http://localhost:3000 in development).
NEXT_PUBLIC_SITE_URL=
# Supabase API URL (http://127.0.0.1:54321 for the local stack; printed by `supabase status`).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (sb_publishable_...) or legacy anon key. Safe for the browser: access is
# governed by row level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ───────────── Optional, public ─────────────
# "true" shows "Continue with Google" (the provider must also be enabled in Supabase Auth).
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=
# "true" shows phone OTP sign-in (an SMS provider must also be configured in Supabase Auth).
NEXT_PUBLIC_ENABLE_PHONE_AUTH=
# Google Analytics 4 measurement id (G-XXXXXXXXXX). Loaded only after cookie consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# WhatsApp support number in international format without "+" (e.g. 919876543210). Unset hides the button.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Support address shown on the site; contact-form notifications are sent to it when e-mail is configured.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Inbox that receives contact-form messages and PG visit requests (default: the developer's
# Gmail). Delivery uses Resend when configured, otherwise FormSubmit (no key; the inbox gets a
# one-time "Activate form" e-mail on the very first message, which must be clicked once).
NEXT_PUBLIC_CONTACT_INBOX=

# ───────────── Optional, server only (never exposed to the browser) ─────────────
# Supabase secret (sb_secret_...) or legacy service_role key. BYPASSES RLS. Used only for
# reference-data ingestion, e-mail recipient lookup and the Postgres rate limiter. Without it
# those paths are skipped and rate limiting falls back to per-instance memory.
SUPABASE_SERVICE_ROLE_KEY=
# AI assistant. Provider name ("anthropic"), its API key, and optionally a model id.
# Without a key the assistant runs in rule-based "basic mode".
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_MODEL=
# Google Maps Platform key (Geocoding, Places, Routes). Without it OpenStreetMap services are
# used and route distance / travel time are not shown.
GOOGLE_MAPS_API_KEY=
# Razorpay (online booking payments). Use TEST keys locally (Dashboard > Account & Settings >
# API Keys, test mode). The webhook secret is the one you set on the webhook
# (<site>/api/v1/payments/razorpay/webhook, event payment.captured). All three are required;
# otherwise bookings work but the payment step says online payment is not set up.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Transactional e-mail through Resend: API key and the verified sender, e.g. "ZUVIO <hello@example.com>".
# Both are needed; otherwise e-mail is skipped and logged.
RESEND_API_KEY=
EMAIL_FROM=
# Upstash Redis REST credentials for distributed rate limiting. Both are needed; otherwise the
# Postgres limiter (needs the service-role key) or a per-instance memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Google Search Console verification token (content of the google-site-verification meta tag).
GOOGLE_SITE_VERIFICATION=

# Provided by Vercel automatically (do not set by hand): VERCEL_GIT_COMMIT_SHA and VERCEL_ENV
# are reported by /api/v1/health.
