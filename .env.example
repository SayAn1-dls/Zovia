# ZUVIO environment. Copy to .env.local (git-ignored) and fill in.
# Only the first three variables are required; every other integration is optional and the
# feature degrades visibly when it is unset (see GET /api/v1/health -> integrations).
# This file lists exactly the variables the code reads (src/server/env.ts).

# ───────────── Required (public: inlined into the browser bundle) ─────────────
# Public base URL of the site, without a trailing slash (http://localhost:3000 in development).
NEXT_PUBLIC_SITE_URL=
# Supabase API URL (http://127.0.0.1:54321 for the local stack; printed by `supabase status`).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (sb_publishable_...) or legacy anon key. Safe for the browser: access is
# governed by row level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ───────────── Optional, public ─────────────
# "true" shows "Continue with Google" (the provider must also be enabled in Supabase Auth).
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=
# "true" shows phone OTP sign-in (an SMS provider must also be configured in Supabase Auth).
NEXT_PUBLIC_ENABLE_PHONE_AUTH=
# Google Analytics 4 measurement id (G-XXXXXXXXXX). Loaded only after cookie consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# WhatsApp support number in international format without "+" (e.g. 919876543210). Unset hides the button.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Link to a published Android APK (an https URL, or a path such as /zovia.apk). Unset hides the
# "Download APK" button on /get-the-app; the install-from-browser steps always show.
NEXT_PUBLIC_APK_URL=
# Support address shown on the site; contact-form notifications are sent to it when e-mail is configured.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Inbox that receives contact-form messages, feedback and PG visit requests (default:
# sayan.bh.work@gmail.com). Nobody may type this address, or its Gmail dot/plus spellings, as their
# own e-mail in those forms. Delivery needs Resend (RESEND_API_KEY + EMAIL_FROM below; see docs/contact-mail-setup.md). The
# no-key fallback, FormSubmit, is refused (HTTP 403) when called from a hosted server such as Vercel.
# Server-only inbox for contact messages and visit requests (never sent to the browser).
CONTACT_INBOX=

# ───────────── Optional, server only (never exposed to the browser) ─────────────
# Supabase secret (sb_secret_...) or legacy service_role key. BYPASSES RLS. Used only for
# reference-data ingestion, e-mail recipient lookup and the Postgres rate limiter. Without it
# those paths are skipped and rate limiting falls back to per-instance memory.
SUPABASE_SERVICE_ROLE_KEY=
# AI assistant. Provider name ("anthropic"), its API key, and optionally a model id.
# AI_MODEL defaults to claude-sonnet-5-5 (fast and cheap enough for a chat assistant). Set it to
# claude-opus-5-5 only if you want the larger, costlier model.
# Without a key the assistant runs in rule-based "basic mode".
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_MODEL=
# Google Maps Platform key (Geocoding, Places, Routes). Without it OpenStreetMap services are
# used and route distance / travel time are not shown.
GOOGLE_MAPS_API_KEY=
# Razorpay (online booking payments). Use TEST keys locally (Dashboard > Account & Settings >
# API Keys, test mode). The webhook secret is the one you set on the webhook
# (<site>/api/v1/payments/razorpay/webhook, event payment.captured). All three are required;
# otherwise bookings work but the payment step says online payment is not set up.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Transactional e-mail through Resend: API key and the sender. With no domain, use the free test sender
# EMAIL_FROM="Zovia <onboarding@resend.dev>" and sign up at resend.com with the CONTACT_INBOX address: it
# can then deliver contact messages to that inbox (see docs/contact-mail-setup.md).
# Both are needed; otherwise e-mail is skipped and logged.
RESEND_API_KEY=
EMAIL_FROM=
# Stay booking receipts. Leave empty unless the business is GST-registered: with both the legal
# name and the GSTIN set, receipts are titled "Tax invoice"; otherwise "Booking confirmation and receipt".
INVOICE_LEGAL_NAME=
INVOICE_GSTIN=
INVOICE_ADDRESS=
# Secret for the scheduled jobs (/api/v1/cron/*): expire unpaid holds and stale requests. Vercel Cron
# sends it automatically as a bearer token when CRON_SECRET is set in the project. Any long random string.
CRON_SECRET=
# Upstash Redis REST credentials for distributed rate limiting. Both are needed; otherwise the
# Postgres limiter (needs the service-role key) or a per-instance memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Google Search Console verification token (content of the google-site-verification meta tag).
GOOGLE_SITE_VERIFICATION=

# Provided by Vercel automatically (do not set by hand): VERCEL_GIT_COMMIT_SHA and VERCEL_ENV
# are reported by /api/v1/health.

# ── Scaling ──
# "memory" forces the single-process demo store even when Supabase is set (local demos only:
# it does not work with more than one server instance). Leave empty in production.
NEXT_PUBLIC_DATA_BACKEND=
# Requests one server instance works on at once before answering 503 + Retry-After (default 256).
API_MAX_IN_FLIGHT=

# ── Security ──
# Comma-separated e-mails allowed to use admin / moderator powers. A staff role in the database
# counts ONLY for these addresses. Default: the developer's address.
ADMIN_EMAILS=
# Secret for detailed /api/v1/health output (send it as the x-health-token header). Without it,
# the public health check only says "ok" or "degraded".
HEALTH_CHECK_TOKEN=
# Hosted deployments (Vercel) refuse the demo memory store when Supabase is not configured. Set to 1
# only to run that demo store there on purpose (data is lost between invocations).
ALLOW_MEMORY_IN_PRODUCTION=
